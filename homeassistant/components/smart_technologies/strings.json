  "issues": {
    "cannot_communicate": {
      "description": "Home Assistant has not been able to communicate with the projector on {port} for several minutes.\n\nCheck that:\n- the projector is connected to power (it does not need to be on),\n- the RS-232 cable and the USB adapter are firmly connected, and the cable is straight-through as described in the projector's guide,\n- the serial port has not changed. If it has, use **Reconfigure** on the integration to select the new port.\n\nHome Assistant reconnects automatically, and this issue disappears once the projector answers again.",
      "title": "Cannot communicate with {title}"
    }
  },
  "services": {
    "adjust_value": {
      "description": "Changes a setting of the projector by a relative amount, using the key from the SMART RS-232 command reference.",
      "fields": {
        "delta": {
          "description": "How much to add to (positive) or subtract from (negative) the current value.",
          "name": "Change"
        },
        "key": {
          "description": "The setting to change, for example `brightness`.",
          "name": "Key"
        },
        "source": {
          "description": "Change the value for this currently inactive input, for example `vga1`, instead of the active input.",
          "name": "Input"
        }
      },
      "name": "Adjust value"
    },
    "get_value": {
      "description": "Reads a setting from the projector using the key from the SMART RS-232 command reference, and returns it.",
      "fields": {
        "key": {
          "description": "The setting to read, for example `frequency`.",
          "name": "Key"
        }
      },
      "name": "Get value"
    },
    "set_value": {
      "description": "Sets a setting of the projector using the key from the SMART RS-232 command reference.",
      "fields": {
        "key": {
          "description": "The setting to change, for example `brightness`.",
          "name": "Key"
        },
        "source": {
          "description": "Change the value for this currently inactive input, for example `vga1`, instead of the active input.",
          "name": "Input"
        },
        "value": {
          "description": "The new value, in the form the projector expects, for example `65` or `on`.",
          "name": "Value"
        }
      },
      "name": "Set value"
    }
  }
